<!--
  Compact dock: the minimised home. Five floating glass buttons with nothing
  between them (passthrough shows through): Expand, Recent | New note |
  Templates, Settings. Recent and Templates open a small glass pop-up just
  above the buttons with that one row; picking an item closes it. The thin
  bar underneath is the grab handle for moving the dock; the pin beside it
  turns stick mode on and off (the dock follows the head).

  The round buttons and the pop-up have no background here: the dock system
  puts a liquid-glass slab behind each (src/ui/liquid-glass.ts). New note is
  the theme's primary action, clay with white ink. Element ids are addressed
  from src/systems/compact-dock-system.ts; keep them stable.
-->
<style>
  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-meta.ttf);
    font-weight: 500;
  }

  @font-face {
    font-family: bricolage-subhead;
    src: url(../fonts/bricolage-subhead.ttf);
    font-weight: 600;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-title.ttf);
    font-weight: 700;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-hero.ttf);
    font-weight: 800;
  }

  @font-face {
    font-family: fraunces;
    src: url(../fonts/fraunces-body.ttf);
    font-weight: 400;
  }

  .dock {
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .dock-row {
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .dock-button {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    color: #1f1c19;
    cursor: pointer;
  }

  .dock-new {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 200px;
    height: 64px;
    border-radius: 18px;
    background-color: #b5553a;
    color: #ffffff;
    cursor: pointer;
  }

  .dock-new-label {
    font-family: bricolage;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
  }

  .pin-button {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    color: #1f1c19;
    cursor: pointer;
  }

  .grab {
    width: 180px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 17px;
    cursor: pointer;
  }

  .grab-bar {
    width: 110px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 253, 249, 0.92);
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.18);
  }

  .popover {
    flex-direction: column;
    gap: 12px;
    padding-top: 18px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .popover-title {
    font-family: bricolage;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    color: #1f1c19;
  }

  .pop-row {
    flex-direction: row;
    gap: 12px;
  }

  .pop-card {
    flex-direction: column;
    gap: 6px;
    width: 112px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 10px;
    cursor: pointer;
  }

  .paper-frame {
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.14);
    background-color: #fffdf9;
  }

  .paper-blank {
    width: 112px;
    height: 84px;
    align-items: center;
    justify-content: center;
    background-color: #fffdf9;
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.14);
  }

  .plus-circle {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    background-color: #b5553a;
    color: #ffffff;
  }

  .pop-thumb {
    width: 110px;
    height: 82px;
  }

  .pop-title {
    font-family: bricolage;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: #1f1c19;
  }
</style>
<div id="dock-root" class="dock">
  <div id="dock-popover" class="popover" style="display: none">
    <div id="dock-popover-title" class="popover-title">Recent notes</div>
    <div id="dock-popover-recent" class="pop-row">
        <div id="dock-recent-card-0" class="pop-card">
          <div class="paper-frame"><img id="dock-recent-thumb-0" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="dock-recent-title-0" class="pop-title">Note</div>
        </div>
        <div id="dock-recent-card-1" class="pop-card">
          <div class="paper-frame"><img id="dock-recent-thumb-1" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="dock-recent-title-1" class="pop-title">Note</div>
        </div>
        <div id="dock-recent-card-2" class="pop-card">
          <div class="paper-frame"><img id="dock-recent-thumb-2" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="dock-recent-title-2" class="pop-title">Note</div>
        </div>
        <div id="dock-recent-card-3" class="pop-card">
          <div class="paper-frame"><img id="dock-recent-thumb-3" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="dock-recent-title-3" class="pop-title">Note</div>
        </div>
    </div>
    <div id="dock-popover-templates" class="pop-row" style="display: none">
        <div id="dock-template-blank" class="pop-card">
          <div class="paper-blank"><div class="plus-circle"><Plus width="22" height="22"></Plus></div></div>
          <div class="pop-title">Blank</div>
        </div>
        <div id="dock-template-lined" class="pop-card">
          <div class="paper-frame"><img id="dock-template-img-lined" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="pop-title">Lined</div>
        </div>
        <div id="dock-template-grid" class="pop-card">
          <div class="paper-frame"><img id="dock-template-img-grid" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="pop-title">Grid</div>
        </div>
        <div id="dock-template-dotted" class="pop-card">
          <div class="paper-frame"><img id="dock-template-img-dotted" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="pop-title">Dotted</div>
        </div>
        <div id="dock-template-cornell" class="pop-card">
          <div class="paper-frame"><img id="dock-template-img-cornell" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="pop-title">Cornell</div>
        </div>
        <div id="dock-template-checklist" class="pop-card">
          <div class="paper-frame"><img id="dock-template-img-checklist" class="pop-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="pop-title">Checklist</div>
        </div>
    </div>
  </div>
  <div class="dock-row">
    <div id="dock-expand" class="dock-button">
      <Maximize2 width="26" height="26"></Maximize2>
    </div>
    <div id="dock-recent" class="dock-button">
      <History width="26" height="26"></History>
    </div>
    <div id="dock-new" class="dock-new">
      <Plus width="24" height="24"></Plus>
      <div class="dock-new-label">New note</div>
    </div>
    <div id="dock-templates" class="dock-button">
      <LayoutGrid width="26" height="26"></LayoutGrid>
    </div>
    <div id="dock-settings" class="dock-button">
      <Settings width="26" height="26"></Settings>
    </div>
  </div>
  <div class="dock-row" style="gap: 10px">
    <div id="dock-pin" class="pin-button">
      <Pin width="20" height="20"></Pin>
    </div>
    <div id="dock-grab" class="grab">
      <div id="dock-grab-bar" class="grab-bar"></div>
    </div>
    <div style="width: 44px; height: 44px"></div>
  </div>
</div>
