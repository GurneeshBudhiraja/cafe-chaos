<!--
  The dock: Meta Notes' home, and the only screen at launch. Floating glass
  buttons with nothing between them but passthrough: Settings, Templates,
  Recent in one line, and New note, the main action, at the right end
  (where the dominant hand finds it; mirrored for left-handed use later).
  Settings opens a panel with preferences (stick mode, on by default) and
  account connections (Google Drive, Microsoft). While it is open the
  buttons fade away and the panel takes their place, centred where the eye
  already is; a pinch anywhere outside it (on an invisible catcher the dock
  system places behind it) brings them back. Recent and Templates take the
  stage the same way: Recent is a grid of up to eight notes (ink, title and
  when it was edited), Templates a grid of six papers with a line on what
  each is for; picking an item closes it. The thin bar underneath is the
  grab handle for moving the dock.

  First launch (no notes): #dock-hint, one short line above the buttons,
  points at New note; it goes once the first note exists.

  The round buttons, the pop-up and the hint have no background here: the
  dock system puts a liquid-glass slab behind each (src/ui/liquid-glass.ts).
  New note is the theme's primary action, clay with white ink. Element ids
  are addressed from src/systems/compact-dock-system.ts; keep them stable.
-->
<style>
  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui.ttf);
    font-weight: 500;
  }

  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui-strong.ttf);
    font-weight: 600;
  }

  .dock {
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .dock-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }

  .dock-button {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    align-items: center;
    justify-content: center;
    color: #f7f2ea;
    cursor: pointer;
  }

  .dock-new {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 56px;
    padding-left: 22px;
    padding-right: 26px;
    border-radius: 28px;
    background-color: #d4704f;
    color: #ffffff;
    cursor: pointer;
  }

  .dock-new-label {
    font-family: ui;
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
  }

  .grab {
    width: 160px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    cursor: pointer;
  }

  .grab-bar {
    width: 110px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 250, 242, 0.5);
  }

  .popover {
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 28px;
  }

  .popover-title {
    font-family: ui;
    font-size: 16px;
    font-weight: 600;
    color: #b3aba1;
    padding-left: 6px;
  }

  .pop-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 6px;
    padding-right: 6px;
  }

  .pop-count {
    font-family: ui;
    font-size: 14px;
    font-weight: 500;
    color: #b3aba1;
  }

  .pop-empty {
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 360px;
    padding-top: 18px;
    padding-bottom: 8px;
  }

  .empty-title {
    font-family: ui;
    font-size: 18px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .empty-body {
    font-family: ui;
    font-size: 15px;
    font-weight: 500;
    color: #b3aba1;
  }

  .grid {
    flex-direction: column;
    gap: 10px;
  }

  .grid-row {
    flex-direction: row;
    gap: 10px;
  }

  .hint {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 22px;
  }

  .hint-text {
    font-family: ui;
    font-size: 16px;
    font-weight: 500;
    color: #f7f2ea;
  }

  .settings {
    flex-direction: column;
    gap: 6px;
    width: 460px;
  }

  .set-section {
    font-family: ui;
    font-size: 14px;
    font-weight: 600;
    color: #b3aba1;
    padding-left: 6px;
    padding-top: 6px;
  }

  .set-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 10px;
    border-radius: 18px;
    background-color: rgba(255, 250, 242, 0.06);
    cursor: pointer;
  }

  .set-text {
    flex-direction: column;
    gap: 2px;
  }

  .set-title {
    font-family: ui;
    font-size: 16px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .set-sub {
    font-family: ui;
    font-size: 14px;
    font-weight: 500;
    color: #b3aba1;
  }

  .switch {
    width: 48px;
    height: 28px;
    border-radius: 14px;
    padding-left: 3px;
    padding-right: 3px;
    flex-direction: row;
    align-items: center;
    background-color: #d4704f;
  }

  .knob {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #ffffff;
  }

  .set-button {
    height: 36px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 250, 242, 0.12);
    cursor: pointer;
  }

  .set-button-label {
    font-family: ui;
    font-size: 14px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .set-foot {
    font-family: ui;
    font-size: 14px;
    font-weight: 500;
    color: #b3aba1;
    padding-left: 6px;
    padding-top: 4px;
  }

  .note-card {
    flex-direction: column;
    gap: 8px;
    width: 124px;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 18px;
    background-color: rgba(255, 250, 242, 0.06);
    cursor: pointer;
  }

  .note-paper {
    border-radius: 12px;
    overflow: hidden;
  }

  .note-thumb {
    flex-shrink: 0;
    width: 112px;
    height: 84px;
  }

  .note-text {
    flex-direction: column;
    gap: 2px;
    padding-left: 4px;
  }

  .note-title {
    font-family: ui;
    font-size: 15px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .note-meta {
    font-family: ui;
    font-size: 13px;
    font-weight: 500;
    color: #b3aba1;
  }

  .tpl-card {
    flex-direction: column;
    gap: 8px;
    width: 168px;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 18px;
    background-color: rgba(255, 250, 242, 0.06);
    cursor: pointer;
  }

  .tpl-paper {
    border-radius: 12px;
    overflow: hidden;
  }

  .tpl-img {
    flex-shrink: 0;
    width: 156px;
    height: 117px;
  }

  .tpl-blank {
    flex-shrink: 0;
    width: 156px;
    height: 117px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    background-color: #f4eee4;
  }

  .plus-circle {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    background-color: #d4704f;
    color: #ffffff;
  }
</style>
<div id="dock-root" class="dock">
  <div id="dock-popover" class="popover" style="display: none">
    <div class="pop-head">
      <div id="dock-popover-title" class="popover-title">Recent notes</div>
      <div id="dock-popover-count" class="pop-count">0 notes</div>
    </div>
    <div id="dock-recent-empty" class="pop-empty" style="display: none">
      <div class="empty-title">No notes yet</div>
      <div class="empty-body">Your notes will appear here.</div>
    </div>
    <div id="dock-popover-recent" class="grid">
      <div id="dock-recent-row-0" class="grid-row">
        <div id="dock-recent-card-0" class="note-card">
          <div class="note-paper"><img id="dock-recent-thumb-0" class="note-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="note-text">
