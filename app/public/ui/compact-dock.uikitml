    font-size: 15px;
    font-weight: 400;
    color: #b3aba1;
    padding-top: 24px;
    padding-bottom: 24px;
    width: 556px;
    text-align: center;
  }

  .close-button {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 250, 242, 0.1);
    color: #f7f2ea;
    cursor: pointer;
  }

  .pop-count {
    font-family: ui;
    font-size: 14px;
    font-weight: 400;
    color: #b3aba1;
  }

  .pop-empty {
