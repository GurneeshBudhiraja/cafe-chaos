    gap: 8px;
    height: 56px;
    padding-left: 22px;
    padding-right: 26px;
    border-radius: 28px;
    background-color: #d4704f;
    color: #ffffff;
    cursor: pointer;
  }

  .dock-new-label {
    font-family: ui;
    font-size: 17px;
