    color: #ffffff;
  }

  .grab {
    width: 160px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    cursor: pointer;
  }

  .grab-bar {
    width: 110px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 250, 242, 0.5);
  }

  .popover {
    flex-direction: column;
    gap: 18px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 32px;
  }

  .popover-title {
    font-family: ui;
    font-size: 16px;
    font-weight: 500;
    color: #b3aba1;
  }

  .pop-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 6px;
  }

  .pop-heading {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }

  .pop-actions {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }

  .segmented {
    flex-direction: row;
    gap: 2px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 18px;
    background-color: rgba(255, 250, 242, 0.08);
  }

  .segment {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .segment-label {
    font-family: ui;
    font-size: 14px;
    font-weight: 500;
    color: #b3aba1;
  }

  .all-scroll {
    flex-direction: column;
    gap: 14px;
    width: 556px;
    max-height: 386px;
    overflow: scroll;
    scrollbar-width: 4px;
    scrollbar-color: rgba(255, 250, 242, 0.35);
    scrollbar-border-radius: 2px;
  }

  .all-view {
    flex-direction: column;
    gap: 14px;
  }

  .filters {
    flex-direction: column;
    gap: 10px;
    width: 556px;
  }

  .filter-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .chip-row {
    flex-direction: row;
    gap: 6px;
  }

  .chip {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 250, 242, 0.08);
    cursor: pointer;
  }

  .chip-label {
    font-family: ui;
    font-size: 13px;
    font-weight: 500;
    color: #b3aba1;
  }

  .no-match {
