          <div class="note-text">
            <div id="dock-recent-title-7" class="note-title">Note</div>
            <div id="dock-recent-meta-7" class="note-meta">Edited now</div>
          </div>
        </div>
      </div>
    </div>
    <div id="dock-popover-templates" class="grid" style="display: none">
      <div class="grid-row">
        <div id="dock-template-blank" class="tpl-card">
          <div class="tpl-blank"><div class="plus-circle"><Plus width="22" height="22"></Plus></div></div>
          <div class="note-text">
            <div class="note-title">Blank</div>
            <div class="note-meta">Start fresh</div>
          </div>
        </div>
        <div id="dock-template-lined" class="tpl-card">
          <div class="tpl-paper"><img id="dock-template-img-lined" class="tpl-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
