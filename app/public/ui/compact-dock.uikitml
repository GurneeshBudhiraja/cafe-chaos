    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 14px;
    border-radius: 18px;
    background-color: rgba(255, 250, 242, 0.06);
    cursor: pointer;
  }

  .set-text {
    flex-direction: column;
    gap: 4px;
  }

  .set-title {
    font-family: ui;
    font-size: 16px;
    font-weight: 500;
    color: #f7f2ea;
  }

  .set-sub {
    font-family: ui;
    font-size: 14px;
    font-weight: 400;
    color: #b3aba1;
  }

  .switch {
    width: 48px;
    height: 28px;
    border-radius: 14px;
    padding-left: 3px;
    padding-right: 3px;
    flex-direction: row;
    align-items: center;
    background-color: #d4704f;
  }

