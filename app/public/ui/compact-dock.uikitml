    padding-left: 20px;
    padding-right: 20px;
    border-radius: 22px;
  }

  .hint-text {
    font-family: ui;
    font-size: 16px;
    font-weight: 400;
    color: #f7f2ea;
  }

  .settings {
    flex-direction: column;
    gap: 10px;
    width: 460px;
  }

  .set-section {
    font-family: ui;
    font-size: 14px;
    font-weight: 500;
    color: #b3aba1;
    padding-left: 6px;
    padding-top: 10px;
  }

