            <div class="note-meta">Maths and sketches</div>
          </div>
        </div>
      </div>
      <div class="grid-row">
        <div id="dock-template-dotted" class="tpl-card">
          <div class="tpl-paper"><img id="dock-template-img-dotted" class="tpl-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
