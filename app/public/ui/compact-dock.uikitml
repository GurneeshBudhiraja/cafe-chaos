          <div class="note-text">
            <div id="dock-recent-title-5" class="note-title">Note</div>
            <div id="dock-recent-meta-5" class="note-meta">Edited now</div>
          </div>
        </div>
        <div id="dock-recent-card-6" class="note-card">
          <div class="note-paper"><img id="dock-recent-thumb-6" class="note-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
