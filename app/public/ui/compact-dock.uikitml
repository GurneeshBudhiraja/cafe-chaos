          <div class="note-text">
            <div id="dock-recent-title-3" class="note-title">Note</div>
            <div id="dock-recent-meta-3" class="note-meta">Edited now</div>
          </div>
        </div>
      </div>
      <div id="dock-recent-row-1" class="grid-row">
        <div id="dock-recent-card-4" class="note-card">
          <div class="note-paper"><img id="dock-recent-thumb-4" class="note-thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="note-text">
