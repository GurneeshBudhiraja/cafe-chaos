            <div class="note-meta">Bullet journal</div>
          </div>
        </div>
        <div id="dock-template-cornell" class="tpl-card">
          <div class="tpl-paper"><img id="dock-template-img-cornell" class="tpl-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="note-text">
            <div class="note-title">Cornell</div>
            <div class="note-meta">Study notes</div>
          </div>
        </div>
        <div id="dock-template-checklist" class="tpl-card">
          <div class="tpl-paper"><img id="dock-template-img-checklist" class="tpl-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="note-text">
            <div class="note-title">Checklist</div>
            <div class="note-meta">To-dos</div>
          </div>
        </div>
      </div>
    </div>
    <div id="dock-popover-settings" class="settings" style="display: none">
      <div class="set-section">Preferences</div>
      <div id="set-stick" class="set-row">
        <div class="set-text">
          <div class="set-title">Stick mode</div>
          <div class="set-sub">The dock follows your view</div>
        </div>
        <div id="set-stick-switch" class="switch">
          <div id="set-stick-knob" class="knob"></div>
        </div>
      </div>
      <div class="set-section">Connections</div>
      <div class="set-row">
        <div class="set-text">
          <div class="set-title">Google Drive</div>
          <div class="set-sub">Back up and export your notes</div>
        </div>
        <div id="set-connect-drive" class="set-button">
          <div id="set-connect-drive-label" class="set-button-label">Connect</div>
        </div>
      </div>
      <div class="set-row">
        <div class="set-text">
          <div class="set-title">Microsoft</div>
          <div class="set-sub">Outlook and OneDrive account</div>
        </div>
        <div id="set-connect-microsoft" class="set-button">
          <div id="set-connect-microsoft-label" class="set-button-label">Connect</div>
        </div>
      </div>
      <div class="set-foot">Your notes are saved on this device.</div>
    </div>
  </div>
  <div id="dock-hint" class="hint" style="display: none">
    <div class="hint-text">Pinch New note to start your first page</div>
  </div>
  <div id="dock-row" class="dock-row">
    <div id="dock-settings" class="dock-button">
      <Settings width="22" height="22"></Settings>
    </div>
    <div id="dock-templates" class="dock-button">
      <LayoutGrid width="22" height="22"></LayoutGrid>
    </div>
    <div id="dock-recent" class="dock-button">
      <History width="22" height="22"></History>
    </div>
    <div id="dock-new" class="dock-new">
      <Plus width="20" height="20"></Plus>
      <div class="dock-new-label">New note</div>
    </div>
