        </div>
        <div id="recent-card-1" class="card">
          <div class="paper"><img id="recent-thumb-1" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-1" class="card-title">Note</div>
            <div id="recent-meta-1" class="card-meta">Edited now</div>
          </div>
        </div>
