      </div>
    </div>
    <div id="recent-strip" class="strip">
        <div id="recent-card-0" class="card">
          <div class="paper"><img id="recent-thumb-0" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-0" class="card-title">Note</div>
            <div id="recent-meta-0" class="card-meta">Edited now</div>
