<!--
  Home window: the app's main window, styled like a computer lock screen:
  a photo wallpaper inside a glass frame, the date above a large centred
  clock, then recent notes. Top row: settings (left), compact toggle
  (right). Middle: recent-note cards, four visible, with chevrons to page
  through more (a ray or hand drag also scrolls the strip). Bottom centre:
  New note. Element ids are addressed from src/systems/home-window-system.ts;
  keep them stable.

  Colour: white for primary text and icons, soft white (72%) for secondary
  text, and lime only as the accent on the New note action (and retry), as
  lock screens do: one accent marks the one action that matters.

  Glass: the window itself has no background here. HomeWindowSystem puts a
  shader-drawn slab behind #home-root (src/ui/liquid-glass.ts): the
  wallpaper photo with square corners and no outline (also in compact
  mode, so the white icons stay readable). The cards are light glass tiles on top, like lock-screen
  widgets, and brighten under the pointer.

  Saving is silent, like most notes apps: the status line under the clock
  only appears when a save fails, with a retry button.

  Compact mode hides everything except the top row, which then shows the
  expand toggle (left), New note (centre, icon and label, no pill) and
  settings (right). All three share one 48-unit touch target height and
  26-unit icons, so the row reads as one level of hierarchy.
-->
<style>
  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-meta.ttf);
    font-weight: 500;
  }

  @font-face {
    font-family: bricolage-subhead;
    src: url(../fonts/bricolage-subhead.ttf);
    font-weight: 600;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-title.ttf);
    font-weight: 700;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-hero.ttf);
    font-weight: 800;
  }

  @font-face {
    font-family: fraunces;
    src: url(../fonts/fraunces-body.ttf);
    font-weight: 400;
  }

  .window {
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    padding-top: 22px;
    padding-bottom: 26px;
    padding-left: 26px;
    padding-right: 26px;
    border-radius: 0px;
  }

  .top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .icon-button {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    color: #ffffff;
    cursor: pointer;
  }

  .clock {
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: -30px;
    margin-bottom: 8px;
  }

  .clock-date {
    font-family: bricolage-subhead;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.12px;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.72);
  }

  .clock-time {
    font-family: bricolage;
    font-size: 100px;
    font-weight: 800;
    letter-spacing: -0.5px;
    line-height: 0.95;
    color: #ffffff;
  }

  .status-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .status {
    font-family: bricolage;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  .pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1.5px;
    border-color: rgba(212, 248, 107, 0.7);
    color: #d4f86b;
    cursor: pointer;
  }

  .compact-action {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 24px;
    color: #d4f86b;
    cursor: pointer;
  }

  .compact-label {
    font-family: bricolage;
    font-size: 22px;
    font-weight: 700;
    color: #d4f86b;
    line-height: 1.2;
  }

  .pill-label {
    font-family: bricolage;
    font-weight: 700;
    color: #d4f86b;
    line-height: 1.2;
  }

  .sheet {
    flex-direction: column;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .sheet-text {
    font-family: fraunces;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .recent-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .chevron {
    width: 30px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    color: #ffffff;
    cursor: pointer;
  }

  .strip {
    flex-direction: row;
    gap: 14px;
    width: 534px;
    padding-top: 4px;
    padding-bottom: 4px;
    overflow: scroll;
    scrollbar-width: 0px;
    scrollbar-color: rgba(0, 0, 0, 0);
  }

  .card {
    flex-direction: column;
    flex-shrink: 0;
    gap: 6px;
    width: 123px;
    height: 128px;
    padding-top: 16px;
    padding-bottom: 14px;
    padding-left: 14px;
    padding-right: 12px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.65);
    color: #ffffff;
    cursor: pointer;
  }

  .card-icon {
    width: 24px;
    height: 24px;
    margin-bottom: 4px;
  }

  .card-title {
    font-family: bricolage;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.085px;
    line-height: 1.2;
    color: #ffffff;
  }

  .card-meta {
    font-family: bricolage;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.72);
  }

  .bottom-row {
    flex-direction: row;
    justify-content: center;
    padding-top: 4px;
  }
</style>
<div id="home-root" class="window">
  <div class="top-row">
    <div id="settings-button" class="icon-button">
      <Settings width="26" height="26"></Settings>
    </div>
    <div id="expand-toggle" class="icon-button" style="display: none">
      <Maximize2 width="26" height="26"></Maximize2>
    </div>
    <div id="compact-new-button" class="compact-action" style="display: none">
      <Plus width="26" height="26"></Plus>
      <div class="compact-label">new note</div>
    </div>
    <div id="compact-settings-button" class="icon-button" style="display: none">
      <Settings width="26" height="26"></Settings>
    </div>
    <div id="compact-toggle" class="icon-button">
      <Minimize2 width="26" height="26"></Minimize2>
    </div>
  </div>

  <div id="clock" class="clock">
    <div id="clock-date" class="clock-date">Today</div>
    <div id="clock-time" class="clock-time">--:--</div>
    <div id="status-row" class="status-row" style="display: none">
      <div id="save-status" class="status">Loading</div>
      <div id="save-retry-button" class="pill" style="display: none; padding-top: 6px; padding-bottom: 6px; padding-left: 14px; padding-right: 14px">
        <div class="pill-label" style="font-size: 13px">Try saving again</div>
      </div>
    </div>
  </div>

  <div id="settings-sheet" class="sheet" style="display: none">
    <div class="sheet-text">Settings are coming soon: theme, handedness and pen defaults.</div>
  </div>

  <div id="recent-section" class="recent-row">
    <div id="recent-prev" class="chevron">
      <ChevronLeft width="24" height="24"></ChevronLeft>
    </div>
    <div id="recent-strip" class="strip">
      <div id="recent-card-0" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-0" class="card-title">Note</div>
        <div id="recent-meta-0" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-1" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-1" class="card-title">Note</div>
        <div id="recent-meta-1" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-2" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-2" class="card-title">Note</div>
        <div id="recent-meta-2" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-3" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-3" class="card-title">Note</div>
        <div id="recent-meta-3" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-4" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-4" class="card-title">Note</div>
        <div id="recent-meta-4" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-5" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-5" class="card-title">Note</div>
        <div id="recent-meta-5" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-6" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-6" class="card-title">Note</div>
        <div id="recent-meta-6" class="card-meta">Edited now</div>
      </div>
      <div id="recent-card-7" class="card">
        <FileText class="card-icon"></FileText>
        <div id="recent-title-7" class="card-title">Note</div>
        <div id="recent-meta-7" class="card-meta">Edited now</div>
      </div>
    </div>
    <div id="recent-next" class="chevron">
      <ChevronRight width="24" height="24"></ChevronRight>
    </div>
  </div>

  <div id="bottom-row" class="bottom-row">
    <div id="note-new-button" class="pill" style="width: 230px; height: 46px">
      <Plus width="22" height="22"></Plus>
      <div class="pill-label" style="font-size: 19px">new note</div>
    </div>
  </div>
</div>
