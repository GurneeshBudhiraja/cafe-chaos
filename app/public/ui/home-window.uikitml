          <div class="card-text">
            <div id="recent-title-2" class="card-title">Note</div>
            <div id="recent-meta-2" class="card-meta">Edited now</div>
          </div>
        </div>
        <div id="recent-card-3" class="card">
          <div class="paper"><img id="recent-thumb-3" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-3" class="card-title">Note</div>
            <div id="recent-meta-3" class="card-meta">Edited now</div>
          </div>
        </div>
        <div id="recent-card-4" class="card">
          <div class="paper"><img id="recent-thumb-4" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-4" class="card-title">Note</div>
            <div id="recent-meta-4" class="card-meta">Edited now</div>
          </div>
        </div>
        <div id="recent-card-5" class="card">
          <div class="paper"><img id="recent-thumb-5" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-5" class="card-title">Note</div>
            <div id="recent-meta-5" class="card-meta">Edited now</div>
          </div>
        </div>
        <div id="recent-card-6" class="card">
          <div class="paper"><img id="recent-thumb-6" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-6" class="card-title">Note</div>
            <div id="recent-meta-6" class="card-meta">Edited now</div>
          </div>
        </div>
        <div id="recent-card-7" class="card">
          <div class="paper"><img id="recent-thumb-7" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div class="card-text">
            <div id="recent-title-7" class="card-title">Note</div>
            <div id="recent-meta-7" class="card-meta">Edited now</div>
          </div>
        </div>
    </div>
  </div>
</div>
<div id="window-grab" class="grab">
  <div id="window-grab-bar" class="grab-bar"></div>
</div>
</div>
