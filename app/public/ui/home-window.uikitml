<!--
  Home window: the app's first screen, laid out like a document app's home.
  Top bar: app name (left); clock, settings and compact toggle (right).
  "Start a new note": paper templates; Blank (#note-new-button) is the main
  action and, with compact New note, the only clay element. "Recent notes": cards with a preview of
  each note's real ink, a sort toggle, and chevrons (or a drag) for more.
  Element ids are addressed from src/systems/home-window-system.ts; keep
  them stable. Template and thumbnail images are canvas textures drawn by
  src/ui/paper-preview.ts; the src here is a transparent placeholder.

  Theme (calm, studious): warm frosted glass, warm white paper, warm ink
  text, one clay accent for the main action. The window has no background
  here: HomeWindowSystem puts a frosted glass slab behind #home-root
  (src/ui/liquid-glass.ts), square corners, no outline.

  Saving is silent; #status-row only appears when a save fails.

  The compact toggle hides this window and shows the compact dock
  (public/ui/compact-dock.uikitml) in its place. The pin turns stick mode
  on and off (the window follows the head), and the bar under the window
  (#window-grab) moves it.
-->
<style>
  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-meta.ttf);
    font-weight: 500;
  }

  @font-face {
    font-family: bricolage-subhead;
    src: url(../fonts/bricolage-subhead.ttf);
    font-weight: 600;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-title.ttf);
    font-weight: 700;
  }

  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-hero.ttf);
    font-weight: 800;
  }

  @font-face {
    font-family: fraunces;
    src: url(../fonts/fraunces-body.ttf);
    font-weight: 400;
  }

  .shell {
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .grab {
    width: 200px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    cursor: pointer;
  }

  .grab-bar {
    width: 130px;
    height: 11px;
    border-radius: 6px;
    background-color: rgba(255, 253, 249, 0.92);
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.18);
  }

  .window {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding-top: 22px;
    padding-bottom: 28px;
    padding-left: 34px;
    padding-right: 34px;
    border-radius: 0px;
  }

  .top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .app-title {
    font-family: bricolage;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.14px;
    color: #1f1c19;
  }

  .top-actions {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .clock {
    font-family: bricolage-subhead;
    font-size: 19px;
    font-weight: 600;
    color: #5e574f;
    margin-right: 8px;
  }

  .icon-button {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    color: #1f1c19;
    cursor: pointer;
  }



  .plus-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    align-items: center;
    justify-content: center;
    background-color: #b5553a;
    color: #ffffff;
  }

  .status-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .status {
    font-family: bricolage;
    font-size: 14px;
    font-weight: 500;
    color: #a3221a;
  }

  .pill {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 22px;
    background-color: rgba(255, 253, 249, 0.75);
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.18);
    color: #1f1c19;
    cursor: pointer;
  }

  .pill-label {
    font-family: bricolage;
    font-size: 15px;
    font-weight: 500;
    color: #1f1c19;
  }

  .sheet {
    flex-direction: column;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(255, 253, 249, 0.8);
  }

  .sheet-text {
    font-family: fraunces;
    font-size: 17px;
    line-height: 1.6;
    color: #1f1c19;
  }

  .section-title {
    font-family: bricolage;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.1px;
    line-height: 1.2;
    color: #1f1c19;
  }

  .template-row {
    flex-direction: row;
    gap: 12px;
  }

  .template {
    flex-direction: column;
    gap: 8px;
    width: 136px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 12px;
    cursor: pointer;
  }

  .paper-frame {
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.14);
    background-color: #fffdf9;
  }

  .paper-blank {
    width: 136px;
    height: 102px;
    align-items: center;
    justify-content: center;
    background-color: #fffdf9;
    border-width: 1px;
    border-color: rgba(31, 28, 25, 0.14);
  }

  .template-img {
    width: 134px;
    height: 100px;
  }

  .divider {
    height: 1px;
    background-color: rgba(31, 28, 25, 0.12);
  }

  .section-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .recent-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .chevron {
    width: 30px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    color: #1f1c19;
    cursor: pointer;
  }

  .strip {
    flex-direction: row;
    gap: 16px;
    width: 808px;
    padding-top: 2px;
    padding-bottom: 2px;
    overflow: scroll;
    scrollbar-width: 0px;
    scrollbar-color: rgba(0, 0, 0, 0);
  }

  .card {
    flex-direction: column;
    flex-shrink: 0;
    gap: 6px;
    width: 190px;
    padding-bottom: 4px;
    border-radius: 12px;
    cursor: pointer;
  }

  .thumb {
    width: 188px;
    height: 141px;
  }

  .card-title {
    font-family: bricolage;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.085px;
    line-height: 1.2;
    color: #1f1c19;
  }

  .card-meta {
    font-family: bricolage;
    font-size: 13px;
    font-weight: 500;
    color: #5e574f;
  }

  .empty {
    font-family: fraunces;
    font-size: 17px;
    color: #5e574f;
  }
</style>
<div id="home-shell" class="shell">
<div id="home-root" class="window">
  <div class="top-row">
    <div id="app-title" class="app-title">Meta Notes</div>
    <div id="top-actions" class="top-actions">
      <div id="clock-time" class="clock">--:--</div>
      <div id="window-pin" class="icon-button">
        <Pin width="24" height="24"></Pin>
      </div>
      <div id="settings-button" class="icon-button">
        <Settings width="24" height="24"></Settings>
      </div>
      <div id="compact-toggle" class="icon-button">
        <Minimize2 width="24" height="24"></Minimize2>
      </div>
    </div>
  </div>

  <div id="status-row" class="status-row" style="display: none">
    <div id="save-status" class="status"></div>
    <div id="save-retry-button" class="pill">
      <div class="pill-label">Try saving again</div>
    </div>
  </div>

  <div id="settings-sheet" class="sheet" style="display: none">
    <div class="sheet-text">Settings are coming soon: handedness, pen defaults and paper.</div>
  </div>

  <div id="templates-section" style="flex-direction: column; gap: 10px">
    <div class="section-title">Start a new note</div>
    <div class="template-row">
      <div id="note-new-button" class="template">
        <div class="paper-blank">
          <div class="plus-circle"><Plus width="28" height="28"></Plus></div>
        </div>
        <div class="card-title">Blank</div>
      </div>
      <div id="template-lined" class="template">
        <div class="paper-frame"><img id="template-img-lined" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="card-title">Lined</div>
      </div>
      <div id="template-grid" class="template">
        <div class="paper-frame"><img id="template-img-grid" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="card-title">Grid</div>
      </div>
      <div id="template-dotted" class="template">
        <div class="paper-frame"><img id="template-img-dotted" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="card-title">Dotted</div>
      </div>
      <div id="template-cornell" class="template">
        <div class="paper-frame"><img id="template-img-cornell" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="card-title">Cornell</div>
      </div>
      <div id="template-checklist" class="template">
        <div class="paper-frame"><img id="template-img-checklist" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="card-title">Checklist</div>
      </div>
    </div>
  </div>

  <div id="section-divider" class="divider"></div>

  <div id="recent-section" style="flex-direction: column; gap: 10px">
    <div class="section-head">
      <div class="section-title">Recent notes</div>
      <div id="sort-button" class="pill">
        <ArrowDownUp width="18" height="18"></ArrowDownUp>
        <div id="sort-label" class="pill-label">Recent</div>
      </div>
    </div>
    <div id="recent-empty" class="empty" style="display: none">No notes yet. Pick a page above to start.</div>
    <div class="recent-row">
      <div id="recent-prev" class="chevron">
        <ChevronLeft width="24" height="24"></ChevronLeft>
      </div>
      <div id="recent-strip" class="strip">
        <div id="recent-card-0" class="card">
          <div class="paper-frame"><img id="recent-thumb-0" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-0" class="card-title">Note</div>
          <div id="recent-meta-0" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-1" class="card">
          <div class="paper-frame"><img id="recent-thumb-1" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-1" class="card-title">Note</div>
          <div id="recent-meta-1" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-2" class="card">
          <div class="paper-frame"><img id="recent-thumb-2" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-2" class="card-title">Note</div>
          <div id="recent-meta-2" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-3" class="card">
          <div class="paper-frame"><img id="recent-thumb-3" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-3" class="card-title">Note</div>
          <div id="recent-meta-3" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-4" class="card">
          <div class="paper-frame"><img id="recent-thumb-4" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-4" class="card-title">Note</div>
          <div id="recent-meta-4" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-5" class="card">
          <div class="paper-frame"><img id="recent-thumb-5" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-5" class="card-title">Note</div>
          <div id="recent-meta-5" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-6" class="card">
          <div class="paper-frame"><img id="recent-thumb-6" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-6" class="card-title">Note</div>
          <div id="recent-meta-6" class="card-meta">Edited now</div>
        </div>
        <div id="recent-card-7" class="card">
          <div class="paper-frame"><img id="recent-thumb-7" class="thumb" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
          <div id="recent-title-7" class="card-title">Note</div>
          <div id="recent-meta-7" class="card-meta">Edited now</div>
        </div>
      </div>
      <div id="recent-next" class="chevron">
        <ChevronRight width="24" height="24"></ChevronRight>
      </div>
    </div>
  </div>
</div>
<div id="window-grab" class="grab">
  <div id="window-grab-bar" class="grab-bar"></div>
</div>
</div>
