<!--
  Home window: the app's first screen.

  Layout, top to bottom (one thing at a time: Recent is the hero, the
  paper choice only appears when asked for):
  - Header: a greeting in the display serif with the date and time under it
    (left); New note, the one clay button, and a glass capsule of controls
    (right): pin (stick mode), settings, minimise.
  - "Choose a paper" (#templates-section, hidden until New note is tapped):
    Blank (#note-new-button) and the paper templates. HomeWindowSystem
    floats it as a glass sheet over Recent (absolute position, lifted
    forward) and animates it out of the New note button.
  - "Recent": cards that preview each note's real ink, with the sort pill
    and round prev/next buttons in the section header.
  - First launch (no notes): #recent-empty, a short invitation, takes the
    place of Recent and the paper choice stays open under it.

  Theme: dark warm smoked glass with warm-white text (src/ui/theme.ts has
  the same colours for code). Paper stays warm white.

  Design notes (see the redesign research): medium weights rather than bold
  (Meta: Light/Thin wash out, overused Strong shouts), one accent colour,
  generous spacing instead of dividers, and concentric rounded shapes (the
  window radius minus its padding gives the inner radii). The window has no
  background here: HomeWindowSystem draws a glass slab behind #home-root
  (src/ui/liquid-glass.ts) with the same corner radius.

  Messages (coming soon, save failures) are toasts (public/ui/toast.uikitml),
  not text inside the window. Element ids are addressed from
  src/systems/home-window-system.ts; keep them stable. Template and
  thumbnail images are canvas textures (src/ui/paper-preview.ts); the src
  here is a transparent placeholder.
-->
<style>
  @font-face {
    font-family: display;
    src: url(../fonts/fraunces-display.ttf);
    font-weight: 400;
  }

  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-text.ttf);
    font-weight: 400;
  }

  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui.ttf);
    font-weight: 500;
  }

  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui-strong.ttf);
    font-weight: 600;
  }

  .shell {
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .grab {
    width: 220px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    cursor: pointer;
  }

  .grab-bar {
    width: 120px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 250, 242, 0.5);
  }

  .window {
    flex-direction: column;
    align-items: stretch;
    gap: 30px;
    padding-top: 34px;
    padding-bottom: 38px;
    padding-left: 40px;
    padding-right: 40px;
    border-radius: 44px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .greeting-block {
    flex-direction: column;
    gap: 4px;
  }

  .greeting {
    font-family: display;
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -0.4px;
    line-height: 1.15;
    color: #f7f2ea;
  }

  .subline {
    font-family: ui;
    font-size: 17px;
    font-weight: 500;
    color: #b3aba1;
  }

  .subline-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: #b3aba1;
  }

  .header-actions {
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .picker {
    flex-direction: column;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
    margin-left: -20px;
    margin-right: -20px;
    border-radius: 30px;
    background-color: rgba(255, 250, 242, 0.06);
  }

  .controls {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 30px;
    background-color: rgba(255, 250, 242, 0.08);
  }

  .icon-button {
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border-radius: 25px;
    color: #ebe4da;
    cursor: pointer;
  }

  .section {
    flex-direction: column;
    gap: 14px;
  }

  .section-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 44px;
  }

  .section-title {
    font-family: ui;
    font-size: 19px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .head-actions {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .pill {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding-left: 16px;
    padding-right: 18px;
    border-radius: 22px;
    background-color: rgba(255, 250, 242, 0.08);
    color: #ebe4da;
    cursor: pointer;
  }

  .pill-label {
    font-family: ui;
    font-size: 16px;
    font-weight: 500;
    color: #ebe4da;
  }

  .round {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 250, 242, 0.08);
    color: #ebe4da;
    cursor: pointer;
  }

  .template-row {
    flex-direction: row;
    gap: 14px;
  }

  .template {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 128px;
    padding-top: 6px;
    padding-bottom: 8px;
    border-radius: 22px;
    cursor: pointer;
  }

  .paper {
    border-radius: 14px;
    overflow: hidden;
  }

  .paper-blank {
    width: 116px;
    height: 88px;
    border-radius: 14px;
    align-items: center;
    justify-content: center;
    background-color: #f4eee4;
  }

  .plus-circle {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    background-color: #d4704f;
    color: #ffffff;
  }

  .template-img {
    width: 116px;
    height: 88px;
  }

  .template-label {
    font-family: ui;
    font-size: 16px;
    font-weight: 500;
    color: #ebe4da;
  }

  .strip {
    flex-direction: row;
    gap: 18px;
    width: 838px;
    overflow: scroll;
    scrollbar-width: 0px;
    scrollbar-color: rgba(0, 0, 0, 0);
  }

  .card {
    flex-direction: column;
    flex-shrink: 0;
    gap: 12px;
    width: 196px;
    padding-top: 6px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 24px;
    cursor: pointer;
  }

  .thumb {
    width: 184px;
    height: 138px;
  }

  .card-text {
    flex-direction: column;
    gap: 3px;
    padding-left: 4px;
  }

  .card-title {
    font-family: ui;
    font-size: 17px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .card-meta {
    font-family: ui;
    font-size: 15px;
    font-weight: 400;
    color: #b3aba1;
  }

  .empty {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .empty-art {
    width: 88px;
    height: 88px;
    border-radius: 44px;
    align-items: center;
    justify-content: center;
    background-color: rgba(212, 112, 79, 0.18);
    color: #d4704f;
  }

  .empty-text {
    flex-direction: column;
    gap: 6px;
  }

  .empty-title {
    font-family: display;
    font-size: 28px;
    font-weight: 400;
    color: #f7f2ea;
  }

  .empty-body {
    font-family: ui;
    font-size: 17px;
    font-weight: 400;
    color: #b3aba1;
  }

  .primary {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 52px;
    padding-left: 20px;
    padding-right: 24px;
    border-radius: 26px;
    background-color: #d4704f;
    color: #ffffff;
    cursor: pointer;
  }

  .primary-label {
    font-family: ui;
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
  }
</style>
<div id="home-shell" class="shell">
<div id="home-root" class="window">
  <div class="header">
    <div class="greeting-block">
      <div id="greeting" class="greeting">Good evening</div>
      <div class="subline-row">
        <div id="clock-date" class="subline">--</div>
        <div class="dot"></div>
        <div id="clock-time" class="subline">--</div>
      </div>
    </div>
    <div class="header-actions">
    <div id="new-note-button" class="primary">
      <Plus id="new-note-icon" width="22" height="22"></Plus>
      <div class="primary-label">New note</div>
    </div>
    <div class="controls">
      <div id="window-pin" class="icon-button">
        <Pin width="22" height="22"></Pin>
      </div>
      <div id="settings-button" class="icon-button">
        <Settings width="22" height="22"></Settings>
      </div>
      <div id="compact-toggle" class="icon-button">
        <Minimize2 width="22" height="22"></Minimize2>
      </div>
    </div>
    </div>
  </div>

  <div id="recent-empty" class="empty" style="display: none">
    <div class="empty-art"><NotebookPen width="40" height="40"></NotebookPen></div>
    <div class="empty-text">
      <div class="empty-title">Your notes will live here</div>
      <div class="empty-body">Pick a paper to start your first note.</div>
    </div>
  </div>

  <div id="templates-section" class="picker" style="display: none">
    <div id="picker-title" class="section-title">Choose a paper</div>
    <div class="template-row">
      <div id="note-new-button" class="template">
        <div class="paper-blank">
          <div class="plus-circle"><Plus width="24" height="24"></Plus></div>
        </div>
        <div class="template-label">Blank</div>
      </div>
      <div id="template-lined" class="template">
        <div class="paper"><img id="template-img-lined" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="template-label">Lined</div>
      </div>
      <div id="template-grid" class="template">
        <div class="paper"><img id="template-img-grid" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="template-label">Grid</div>
      </div>
      <div id="template-dotted" class="template">
        <div class="paper"><img id="template-img-dotted" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="template-label">Dotted</div>
      </div>
      <div id="template-cornell" class="template">
        <div class="paper"><img id="template-img-cornell" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="template-label">Cornell</div>
      </div>
      <div id="template-checklist" class="template">
        <div class="paper"><img id="template-img-checklist" class="template-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" /></div>
        <div class="template-label">Checklist</div>
      </div>
    </div>
  </div>

  <div id="recent-section" class="section">
    <div class="section-head">
      <div class="section-title">Recent</div>
      <div id="recent-actions" class="head-actions">
        <div id="sort-button" class="pill">
          <ArrowDownUp width="18" height="18"></ArrowDownUp>
          <div id="sort-label" class="pill-label">Last edited</div>
        </div>
        <div id="recent-prev" class="round">
          <ChevronLeft width="22" height="22"></ChevronLeft>
        </div>
        <div id="recent-next" class="round">
          <ChevronRight width="22" height="22"></ChevronRight>
