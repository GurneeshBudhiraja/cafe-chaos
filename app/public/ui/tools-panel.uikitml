<!--
  Tools panel: XR entry, the camera capture trial, and device feature status.
  Element ids below are addressed from src/systems/*.ts; keep them stable.
  Buttons are glass pills (plain elements with click listeners); the icons
  are bundled Lucide components.

  Headset glass, matching the home window: a blue tint and a bright rim. A
  web app cannot blur Quest passthrough, so glass here is tint + rim, not
  frosting.
-->
<style>
  @font-face {
    font-family: bricolage;
    src: url(../fonts/bricolage-title.ttf);
    font-weight: 700;
  }

  @font-face {
    font-family: fraunces;
    src: url(../fonts/fraunces-body.ttf);
    font-weight: 400;
  }

  .panel-root {
    flex-direction: column;
    width: 344px;
    padding-top: 6px;
    padding-bottom: 18px;
    border-radius: 32px;
    background-color: rgba(30, 84, 160, 0.58);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .section {
    flex-direction: column;
    padding-top: 12px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .heading {
    font-family: bricolage;
    font-size: 24px;
    font-weight: 700;
    color: #d4f86b;
  }

  .section-title {
    font-family: bricolage;
    font-size: 16px;
    font-weight: 700;
    color: #d4f86b;
    margin-bottom: 6px;
  }

  .body-text {
    font-family: fraunces;
    font-size: 13px;
    line-height: 1.3;
    color: #e2faa8;
  }

  .rule {
    height: 1px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.35);
  }

  .button-row {
    flex-direction: row;
    gap: 8px;
    margin-top: 10px;
  }

  .pill {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding-left: 14px;
    padding-right: 16px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1.5px;
    border-color: rgba(212, 248, 107, 0.7);
    color: #d4f86b;
    cursor: pointer;
  }

  .pill-label {
    font-family: bricolage;
    font-size: 14px;
    font-weight: 700;
    color: #d4f86b;
  }

  .preview {
    width: 300px;
    height: 169px;
    margin-top: 10px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .feature-row {
    width: 300px;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
  }
</style>
<div class="panel-root">
  <div class="section">
    <div class="heading">Meta Notes</div>
    <div class="button-row">
      <div id="xr-enter-button" class="pill">
        <RectangleGoggles width="18" height="18"></RectangleGoggles>
        <div class="pill-label">Enter XR</div>
      </div>
      <div id="xr-exit-button" class="pill" style="display: none">
        <LogIn width="18" height="18"></LogIn>
        <div class="pill-label">Exit to browser</div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="rule"></div>
    <div class="section-title" style="margin-top: 10px">Camera capture</div>
    <div id="camera-status" class="body-text">
      Camera is off. Start it to take a still image.
    </div>
    <div class="button-row">
      <div id="camera-start-button" class="pill">
        <Camera width="18" height="18"></Camera>
        <div class="pill-label">Start camera</div>
      </div>
      <div id="camera-capture-button" class="pill" style="display: none">
        <Aperture width="18" height="18"></Aperture>
        <div class="pill-label">Capture</div>
      </div>
      <div id="camera-stop-button" class="pill" style="display: none">
        <X width="18" height="18"></X>
        <div class="pill-label">Stop</div>
      </div>
    </div>
    <!-- src starts as a transparent 16x9 placeholder (the glass shows through); the camera system swaps in
         the live video texture and then the captured still. -->
    <img id="camera-preview" class="preview" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAD0lEQVR42mNgGAWjgAoAAAJJAAFgJMPaAAAAAElFTkSuQmCC" />
  </div>

  <div class="section">
    <div class="rule"></div>
    <div class="section-title" style="margin-top: 10px">Device features</div>
    <div class="feature-row">
      <div class="body-text">Camera</div>
      <div id="feature-camera" class="body-text">Checking</div>
    </div>
    <div class="feature-row">
      <div class="body-text">Hand tracking</div>
      <div id="feature-hands" class="body-text">Checking</div>
    </div>
    <div class="feature-row">
      <div class="body-text">Surfaces</div>
      <div id="feature-planes" class="body-text">Checking</div>
    </div>
    <div class="feature-row">
      <div class="body-text">Room anchors</div>
      <div id="feature-anchors" class="body-text">Checking</div>
    </div>
  </div>
</div>
