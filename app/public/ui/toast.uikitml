<!--
  Toast: one slim line for app messages. A small tinted icon says what kind
  of message it is (info, done, error), the title says what happened, an
  optional detail follows on the same line, and an optional small pill
  offers one action ("Try again"). ToastSystem (src/systems/toast-system.ts)
  fills it in, puts a glass slab behind #toast-root and shows it at the top
  centre of the view, apart from the app. Keep the ids stable.
-->
<style>
  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-text.ttf);
    font-weight: 400;
  }

  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui-strong.ttf);
    font-weight: 600;
  }

  .toast {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding-left: 16px;
    padding-right: 8px;
    border-radius: 24px;
  }

  .badge {
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    color: #d4704f;
  }

  .title {
    font-family: ui;
    font-size: 16px;
    font-weight: 600;
    color: #f7f2ea;
  }

  .body {
    font-family: ui;
    font-size: 15px;
    font-weight: 400;
    color: #b3aba1;
    max-width: 380px;
  }

  .end {
    width: 10px;
  }

  .action {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
    background-color: #f7f2ea;
    cursor: pointer;
  }

  .action-label {
    font-family: ui;
    font-size: 14px;
    font-weight: 600;
    color: #1f1c19;
  }
</style>
<div id="toast-root" class="toast">
  <div id="toast-badge" class="badge">
    <Sparkles id="toast-icon-info" width="18" height="18"></Sparkles>
    <Check id="toast-icon-done" width="18" height="18" style="display: none"></Check>
    <CloudOff id="toast-icon-error" width="18" height="18" style="display: none"></CloudOff>
  </div>
  <div id="toast-title" class="title">Title</div>
  <div id="toast-body" class="body">Body</div>
  <div id="toast-action" class="action" style="display: none">
    <div id="toast-action-label" class="action-label">Try again</div>
  </div>
  <div id="toast-end" class="end"></div>
</div>
