<!--
  Type toolbar: the formatting bar under the floating page in Type mode,
  laid out like Google Docs' toolbar (undo and redo; text styles; bold,
  italic, underline, strikethrough; lists; indent; alignment; clear
  formatting), and below it the grab bar that moves the page.
  TypeModeSystem (src/systems/type-mode-system.ts) places it under the page
  and puts a glass slab behind #type-toolbar-row; TypeToolbarSystem wires
  the buttons. Keep the ids stable: each button's id is its command.
-->
<style>
  @font-face {
    font-family: ui;
    src: url(../fonts/bricolage-ui.ttf);
    font-weight: 500;
  }

  .root {
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .toolbar {
    flex-direction: row;
    align-items: center;
    gap: 2px;
    height: 56px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 28px;
  }

  .tool {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    align-items: center;
    justify-content: center;
    color: #f7f2ea;
    cursor: pointer;
  }

  .divider {
    width: 1.5px;
    height: 24px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(255, 250, 242, 0.18);
  }

  .grab {
    width: 150px;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(255, 250, 242, 0.55);
    cursor: pointer;
  }
</style>
<div id="type-toolbar-root" class="root">
  <div id="type-toolbar-row" class="toolbar">
    <div id="tool-undo" class="tool"><Undo2 width="20" height="20"></Undo2></div>
    <div id="tool-redo" class="tool"><Redo2 width="20" height="20"></Redo2></div>
    <div class="divider"></div>
    <div id="tool-paragraph" class="tool"><Pilcrow width="20" height="20"></Pilcrow></div>
    <div id="tool-title" class="tool"><Heading1 width="21" height="21"></Heading1></div>
    <div id="tool-heading" class="tool"><Heading2 width="21" height="21"></Heading2></div>
    <div id="tool-subheading" class="tool"><Heading3 width="21" height="21"></Heading3></div>
    <div class="divider"></div>
    <div id="tool-bold" class="tool"><Bold width="20" height="20"></Bold></div>
    <div id="tool-italic" class="tool"><Italic width="20" height="20"></Italic></div>
    <div id="tool-underline" class="tool"><Underline width="20" height="20"></Underline></div>
    <div id="tool-strike" class="tool"><Strikethrough width="20" height="20"></Strikethrough></div>
    <div class="divider"></div>
    <div id="tool-bullet" class="tool"><List width="21" height="21"></List></div>
    <div id="tool-numbered" class="tool"><ListOrdered width="21" height="21"></ListOrdered></div>
    <div id="tool-checklist" class="tool"><ListTodo width="21" height="21"></ListTodo></div>
    <div id="tool-quote" class="tool"><TextQuote width="20" height="20"></TextQuote></div>
    <div class="divider"></div>
    <div id="tool-outdent" class="tool"><IndentDecrease width="20" height="20"></IndentDecrease></div>
    <div id="tool-indent" class="tool"><IndentIncrease width="20" height="20"></IndentIncrease></div>
    <div class="divider"></div>
    <div id="tool-align-left" class="tool"><AlignLeft width="20" height="20"></AlignLeft></div>
    <div id="tool-align-center" class="tool"><AlignCenter width="20" height="20"></AlignCenter></div>
    <div id="tool-align-right" class="tool"><AlignRight width="20" height="20"></AlignRight></div>
    <div class="divider"></div>
    <div id="tool-clear" class="tool"><RemoveFormatting width="20" height="20"></RemoveFormatting></div>
  </div>
  <div id="type-toolbar-grab" class="grab"></div>
</div>
