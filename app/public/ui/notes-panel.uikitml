<!--
  Notes panel: note library, the active note's title and text, save status,
  and delete with confirmation. Element ids are addressed from
  src/systems/notes-panel-system.ts; keep them stable.
  The list shows five rows at a time; the Newer/Older buttons page through it.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 344px;
    padding-bottom: 16px;
  }

  .section {
    flex-direction: column;
    padding-top: 12px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .heading {
    font-size: 22px;
    font-weight: 700;
    color: #272727;
  }

  .status {
    font-size: 13px;
    font-weight: 500;
    color: #3a3a3a;
  }

  .label {
    font-size: 12px;
    font-weight: 700;
    color: #555555;
    margin-top: 8px;
    margin-bottom: 4px;
  }

  .body-text {
    font-size: 13px;
    line-height: 1.3;
    color: #3a3a3a;
  }

  .alert {
    flex-direction: column;
    margin-top: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 8px;
    background-color: #fde8e8;
  }

  .alert-text {
    font-size: 13px;
    line-height: 1.3;
    color: #8a1c1c;
  }

  .button-row {
    flex-direction: row;
    gap: 8px;
    margin-top: 8px;
  }

  .field {
    color: #1f1f1f;
  }

  .note-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 304px;
    height: 34px;
    margin-top: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 8px;
    background-color: #f1f0ec;
    cursor: pointer;
  }

  .note-row-title {
    font-size: 14px;
    font-weight: 500;
    color: #272727;
  }

  .note-row-meta {
    font-size: 11px;
    color: #6b6b6b;
  }
</style>
<Panel class="panel-root">
  <div class="section">
    <div class="header">
      <div class="heading">Notes</div>
      <div id="save-status" class="status">Loading</div>
    </div>

    <div id="save-alert" class="alert" style="display: none">
      <div id="save-alert-text" class="alert-text">
        Save failed. Your changes are kept on this page.
      </div>
      <div class="button-row">
        <Button id="save-retry-button" size="sm">
          <ButtonLabel>Try saving again</ButtonLabel>
        </Button>
      </div>
    </div>

    <div class="button-row">
      <Button id="note-new-button">
        <ButtonIcon><Plus></Plus></ButtonIcon>
        <ButtonLabel>New note</ButtonLabel>
      </Button>
      <Button id="note-delete-button" variant="secondary">
        <ButtonIcon><Trash2></Trash2></ButtonIcon>
        <ButtonLabel>Delete</ButtonLabel>
      </Button>
    </div>

    <div id="delete-confirm" class="alert" style="display: none">
      <div id="delete-confirm-text" class="alert-text">
        Delete this note? This cannot be undone.
      </div>
      <div class="button-row">
        <Button id="delete-confirm-button" size="sm">
          <ButtonLabel>Delete note</ButtonLabel>
        </Button>
        <Button id="delete-cancel-button" size="sm" variant="secondary">
          <ButtonLabel>Keep note</ButtonLabel>
        </Button>
      </div>
    </div>

    <div class="label">Title</div>
    <Input id="note-title-input" class="field" placeholder="Note title" />
    <div class="label">Text</div>
    <Input id="note-text-input" class="field" placeholder="Type a short note" />
  </div>

  <div class="section">
    <Divider></Divider>
    <div class="header" style="margin-top: 10px">
      <div class="label">All notes</div>
      <div id="note-count" class="note-row-meta">0 notes</div>
    </div>
    <div id="note-row-0" class="note-row">
      <div id="note-row-title-0" class="note-row-title">Note</div>
      <div id="note-row-meta-0" class="note-row-meta">now</div>
    </div>
    <div id="note-row-1" class="note-row">
      <div id="note-row-title-1" class="note-row-title">Note</div>
      <div id="note-row-meta-1" class="note-row-meta">now</div>
    </div>
    <div id="note-row-2" class="note-row">
      <div id="note-row-title-2" class="note-row-title">Note</div>
      <div id="note-row-meta-2" class="note-row-meta">now</div>
    </div>
    <div id="note-row-3" class="note-row">
      <div id="note-row-title-3" class="note-row-title">Note</div>
      <div id="note-row-meta-3" class="note-row-meta">now</div>
    </div>
    <div id="note-row-4" class="note-row">
      <div id="note-row-title-4" class="note-row-title">Note</div>
      <div id="note-row-meta-4" class="note-row-meta">now</div>
    </div>
    <div class="button-row">
      <Button id="page-newer-button" size="sm" variant="secondary">
        <ButtonLabel>Newer</ButtonLabel>
      </Button>
      <Button id="page-older-button" size="sm" variant="secondary">
        <ButtonLabel>Older</ButtonLabel>
      </Button>
    </div>
  </div>
</Panel>
